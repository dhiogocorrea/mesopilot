# Copy to .env and fill in.
#
# PostgreSQL. On Supabase: Project Settings → Database → Connection string.
#
# Use the *session pooler* URI (port 5432) for `prisma migrate` and the seed,
# and the transaction pooler (port 6543, with `?pgbouncer=true`) for the running
# app if you deploy somewhere serverless — a function per request exhausts
# direct connections otherwise.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# ------------------------------------------------------------------ AI coach
#
# All optional. With none of it set the app runs on the deterministic
# progression engine alone, which is the whole product minus the commentary.
#
# Azure OpenAI is the primary target. You need the key, the *deployment* name
# (not the model name — Azure pins the model to the deployment) and either the
# endpoint or the instance name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_DEPLOYMENT_NAME=
AZURE_OPENAI_ENDPOINT="https://YOUR-RESOURCE.openai.azure.com/"
# Alternative to the endpoint above — just the resource name.
# AZURE_OPENAI_API_INSTANCE_NAME=
# Defaults to 2024-10-21 when unset.
# AZURE_OPENAI_API_VERSION=

# Fallback, used only when the Azure variables above are incomplete.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
