// Orimaz Wellness — training domain model.
//
// Nothing here is provider-specific: no enums (stored as String + TS union
// types), no arrays, no Json columns (JSON is stored as String and parsed
// through typed helpers in src/lib/json.ts). That kept the move off SQLite to
// a one-line datasource change; keep it that way.
//
// All loads are stored in kilograms. Display units are a per-user preference.

/// `relationJoins` makes `join` the default relation load strategy on Postgres,
/// which is the single highest-leverage line in this repo for how the app feels.
///
/// Without it, Prisma resolves a nested `include` as one query *per relation
/// level*. The database is a real server on another continent — ~150ms per
/// round trip — so the Today page spent 1265ms making six sequential queries
/// for what is one join. With the flag: 177ms, one query, byte-identical rows.
///
/// It applies to every nested read in the app, so no query needs to opt in;
/// `relationLoadStrategy: "query"` opts a single one back out if one ever turns
/// out to aggregate badly.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- user

model User {
  id   String @id @default(cuid())
  name String

  /// Stored lowercased; `usernameLower` is what the login query matches on so
  /// "Dhiogo" and "dhiogo" cannot become two accounts. The display form is kept
  /// separately because case is part of how people write their own name.
  username      String @unique
  usernameLower String @unique

  /// Optional: accounts predate email, and a Google sign-in supplies one only
  /// if the athlete consents to share it. `emailLower` is what lookups match
  /// on, for the same reason `usernameLower` exists.
  email      String? @unique
  emailLower String? @unique

  /// Null until the athlete clicks the link. Unverified accounts still work —
  /// blocking them would have locked out every account that predates this.
  emailVerifiedAt DateTime?

  /// scrypt, as `salt:derivedKey` in hex. Never a plaintext password, and never
  /// selected into anything that reaches a client component.
  ///
  /// Nullable: an account created through Google has no password, and inventing
  /// a random one it can never use would be worse than saying so.
  passwordHash String?

  locale    String   @default("en") // Locale: "en" | "pt"
  unit      String   @default("kg") // WeightUnit: "kg" | "lb"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      Profile?
  landmarks    UserMuscleLandmark[]
  mesocycles   Mesocycle[]
  exercises    Exercise[]
  templates    ProgramTemplate[]
  tracks       ProgramTrack[]
  sessions     AuthSession[]
  achievements UserAchievement[]

  friendRequestsSent     Friendship[] @relation("FriendshipRequester")
  friendRequestsReceived Friendship[] @relation("FriendshipAddressee")

  oauthAccounts OAuthAccount[]
  emailTokens   EmailToken[]
}

/// A sign-in provider linked to an account.
///
/// Separate from `User` so one athlete can hold several — a Google login added
/// to an existing password account, rather than a second account with the same
/// person in it.
model OAuthAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "google" for now. A string rather than an enum, like everything else here.
  provider String

  /// The provider's own stable id for the person — `sub` for Google. Matching
  /// on this rather than on email is what stops a changed or recycled address
  /// handing someone else's account over.
  providerAccountId String

  /// What the provider said the address was, kept for support questions only.
  email String?

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// A single-use link sent by email.
model EmailToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the value in the link, never the value — same reasoning as
  /// `AuthSession.tokenHash`: a database dump must not be a book of live links.
  tokenHash String @unique

  /// EmailTokenPurpose: "verify" for now; password reset will reuse this table.
  purpose String

  /// The address this token was issued for. Verifying checks it still matches
  /// the account, so changing your email cancels any link already in flight.
  email String

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

/// A connection between two athletes, and the consent behind it.
///
/// One row per pair, holding whoever asked first — so every read has to look in
/// both directions (`src/server/friends.ts` does). Nobody sees anything of
/// anyone else's until `status` is "accepted": training history is health-
/// adjacent, and a one-sided follow would make it visible without agreement.
model Friendship {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId String
  addressee   User   @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  /// FriendshipStatus: "pending" | "accepted" | "declined".
  ///
  /// A declined row is kept rather than deleted, and the unique constraint
  /// below then stops the same person asking again — deleting it would turn
  /// "no" into a button someone can press once a day.
  status String @default("pending")

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// One unlocked medal. The catalogue itself lives in code
/// (`src/lib/achievements/catalogue.ts`) — only the unlock is a row, because
/// only the unlock is per-athlete and only it needs a timestamp.
model UserAchievement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Matches a key in the code catalogue.
  key String

  /// Snapshotted from the catalogue rather than read through it. A leaderboard
  /// is then `sum(points) group by userId` — one aggregate instead of loading
  /// every unlock and scoring it in JS — and re-pricing a medal later cannot
  /// silently rewrite what people already earned.
  points Int

  /// What the athlete had reached when it fired: 10 sessions, 25000 kg. Kept
  /// so the medal can state the achievement rather than just name it.
  value Int

  unlockedAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

/// A logged-in browser. Named for what it is rather than `Session`, which this
/// schema already uses for a training session.
model AuthSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the cookie value, never the value itself: a leaked database
  /// dump must not hand out working sessions.
  tokenHash String @unique

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Anamnesis. Feeds both the deterministic engine (experience level sets the
/// starting RIR and progression aggressiveness) and the AI coaching layer.
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  birthDate    DateTime?
  sex          String? // "male" | "female" | "other"
  heightCm     Float?
  bodyweightKg Float?

  experience    String @default("intermediate") // Experience: "beginner" | "intermediate" | "advanced"
  trainingYears Float?
  primaryGoal   String @default("hypertrophy") // Goal: "hypertrophy" | "strength" | "fatloss" | "general"

  daysPerWeek    Int @default(4)
  sessionMinutes Int @default(60)

  // Recovery context, 1..5. Low sleep / high stress / poor nutrition make the
  // engine more conservative about adding volume.
  sleepQuality     Int    @default(3)
  stressLevel      Int    @default(3)
  nutritionQuality Int    @default(3)
  caloricState     String @default("maintenance") // "deficit" | "maintenance" | "surplus"

  injuries  String? // JSON: string[]
  equipment String? // JSON: Equipment[]
  notes     String?

  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------- muscle + volume

/// Weekly set landmarks per Renaissance Periodization:
/// MV  = maintenance volume
/// MEV = minimum effective volume  (where a mesocycle starts)
/// MAV = maximum adaptive volume   (the productive middle)
/// MRV = maximum recoverable volume (the ceiling; hitting it triggers a deload)
model MuscleGroup {
  id     String @id @default(cuid())
  key    String @unique
  nameEn String
  namePt String
  order  Int    @default(0)

  mv  Int @default(6)
  mev Int @default(8)
  mav Int @default(16)
  mrv Int @default(22)

  exercises        Exercise[]
  landmarks        UserMuscleLandmark[]
  templateSlots    ProgramTemplateSlot[]
  sessionExercises SessionExercise[]
  sessionFeedback  SessionMuscleFeedback[]
}

/// Per-user calibration of the landmarks above. Written by the engine as it
/// learns how much volume this person actually recovers from.
model UserMuscleLandmark {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscleGroupId String
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  mev Int
  mav Int
  mrv Int

  updatedAt DateTime @updatedAt

  @@unique([userId, muscleGroupId])
}

// ------------------------------------------------------------- exercises

model Exercise {
  id     String  @id @default(cuid())
  key    String? @unique // set for seeded exercises, null for user-created ones
  nameEn String
  namePt String

  muscleGroupId String
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)
  secondary     String? // JSON: string[] of MuscleGroup.key

  equipment    String @default("barbell") // Equipment
  movementType String @default("compound") // "compound" | "isolation"

  defaultRepMin  Int @default(8)
  defaultRepMax  Int @default(12)
  defaultRestSec Int @default(60)

  /// Stimulus-to-fatigue ratio, 1..5. Higher is a better volume buy.
  /// Used to pick which exercise gains sets first when volume is added.
  sfr Int @default(3)

  isCustom Boolean @default(false)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes    String?
  archived Boolean @default(false)

  /// A form demonstration for this movement. Null means the UI falls back to a
  /// search built from the exercise's own name, which can never point at the
  /// wrong lift. The seed only ever fills this when it is null, so re-seeding
  /// cannot wipe a link the athlete curated.
  demoUrl String?

  /// "inferred" — picked automatically by matching a search result title, and
  /// never watched by anyone. Shown as unverified so it can be checked.
  /// "user" — set deliberately by the athlete; trusted.
  demoSource String?

  templateSlots    ProgramTemplateSlot[]
  sessionExercises SessionExercise[]
  /// Rows whose plan is this exercise while today runs a substitute.
  plannedFor       SessionExercise[] @relation("PlannedExercise")
}

// ------------------------------------------------------------- templates

model ProgramTemplate {
  id     String  @id @default(cuid())
  key    String? @unique
  nameEn String
  namePt String
  descEn String  @default("")
  descPt String  @default("")

  daysPerWeek Int
  weeks       Int    @default(5) // includes the trailing deload week
  level       String @default("intermediate")
  goal        String @default("hypertrophy")

  /// Typical length of one session in minutes, derived from the program's own
  /// slots at seed time (see src/lib/training-time.ts) rather than guessed, so
  /// it stays truthful when the exercise list changes. Used to match the
  /// athlete's declared time budget.
  estimatedMinutes Int @default(60)

  isCustom Boolean @default(false)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Where a custom program came from. Null means the athlete built it here;
  /// "import" means it was read out of a file they own. Both are editable and
  /// both are theirs, but only the first is *by* them — labelling an imported
  /// program "My program" would credit them for someone else's work.
  source String?

  days         ProgramTemplateDay[]
  mesocycles   Mesocycle[]
  trackEntries ProgramTrackEntry[]
}

/// An ordered sequence of blocks — a macrocycle. A published program is often
/// several blocks meant to be run back to back (build, then novelty, then a
/// harder grind); without this they arrive as unrelated entries in the picker
/// and the athlete has to remember the order themselves.
model ProgramTrack {
  id     String  @id @default(cuid())
  key    String? @unique
  nameEn String
  namePt String
  descEn String  @default("")
  descPt String  @default("")

  isCustom Boolean @default(false)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// See ProgramTemplate.source.
  source String?

  entries    ProgramTrackEntry[]
  mesocycles Mesocycle[]
}

model ProgramTrackEntry {
  id      String       @id @default(cuid())
  trackId String
  track   ProgramTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  order      Int
  templateId String
  template   ProgramTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([trackId, order])
}

model ProgramTemplateDay {
  id         String          @id @default(cuid())
  templateId String
  template   ProgramTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  order   Int
  labelEn String
  labelPt String

  slots ProgramTemplateSlot[]

  @@unique([templateId, order])
}

model ProgramTemplateSlot {
  id    String             @id @default(cuid())
  dayId String
  day   ProgramTemplateDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  order         Int
  exerciseId    String
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroupId String
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  startingSets Int @default(3)
  repMin       Int @default(8)
  repMax       Int @default(12)
  restSec      Int @default(120)

  @@unique([dayId, order])
}

// ------------------------------------------------------------ mesocycles

model Mesocycle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String?
  template   ProgramTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// Set when this block is one step of a track. Position is an index rather
  /// than a reference to the entry row, because re-importing a program rebuilds
  /// its entries and would orphan a foreign key mid-track.
  trackId       String?
  track         ProgramTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)
  trackPosition Int?

  name        String
  weeks       Int    @default(5)
  daysPerWeek Int
  /// RIR target for week 1. Ramps linearly to 0 on the last training week.
  startRir    Int    @default(3)

  status      String    @default("active") // "active" | "completed" | "abandoned"
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  notes       String?

  sessions Session[]
}

model Session {
  id          String    @id @default(cuid())
  mesocycleId String
  mesocycle   Mesocycle @relation(fields: [mesocycleId], references: [id], onDelete: Cascade)

  week     Int
  dayIndex Int
  label    String
  isDeload Boolean @default(false)

  status       String    @default("planned") // "planned" | "in_progress" | "completed" | "skipped"
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  notes        String?

  entries  SessionExercise[]
  feedback SessionMuscleFeedback[]

  @@unique([mesocycleId, week, dayIndex])
}

/// Autoregulation feedback, asked once per muscle group per session.
///
/// The four questions are about a *muscle*, not a movement: "how sore was your
/// chest coming in" has one answer however many chest exercises you did. Asking
/// per exercise produced several answers to the same question — and when they
/// disagreed, the engine read the same muscle's recovery two different ways
/// while deciding how to split that muscle's volume.
model SessionMuscleFeedback {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  muscleGroupId String
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  soreness  Int // 0 never sore .. 3 still sore
  pump      Int // 0 low .. 2 amazing
  workload  Int // 0 easy .. 3 too much
  jointPain Int // 0 none .. 2 a lot

  answeredAt DateTime @default(now())

  @@unique([sessionId, muscleGroupId])
  @@index([sessionId])
}

model SessionExercise {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  order         Int
  exerciseId    String
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroupId String
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  /// How this row relates to the plan. The plan *is* the sessions — next week
  /// is generated from this week's entries — so an edit made mid-workout is a
  /// permanent one unless the row says otherwise. EntryPlan in lib/types.ts.
  ///   "planned" — do it today, carry it forward.
  ///   "extra"   — added for today only; next week does not inherit it.
  ///   "skipped" — kept in the plan, not being done today.
  plan String @default("planned")

  /// Set when a movement was substituted *for today only*: the athlete trains
  /// `exerciseId`, and the week generated from this one goes back to this.
  plannedExerciseId String?
  plannedExercise   Exercise? @relation("PlannedExercise", fields: [plannedExerciseId], references: [id], onDelete: SetNull)

  targetSets Int
  repMin     Int
  repMax     Int
  targetRir  Int
  restSec    Int @default(120)

  // Feedback lives on SessionMuscleFeedback, one row per muscle per session —
  // it was here once, which meant asking the same question of every exercise.

  aiNote String?

  sets      SetLog[]
  decisions ProgressionDecision[] @relation("DecisionTarget")

  @@unique([sessionId, order])
}

model SetLog {
  id                String          @id @default(cuid())
  sessionExerciseId String
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  order     Int
  weightKg  Float?
  reps      Int?
  rir       Int?
  completed Boolean   @default(false)
  isWarmup  Boolean   @default(false)
  loggedAt  DateTime?

  @@unique([sessionExerciseId, order])
}

/// Audit trail: why the next session looks the way it does. Every prescription
/// change is explained, so the app can always answer "why am I doing 4 sets?".
model ProgressionDecision {
  id String @id @default(cuid())

  /// The upcoming SessionExercise this decision produced.
  sessionExerciseId String
  sessionExercise   SessionExercise @relation("DecisionTarget", fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  /// The completed SessionExercise the decision was derived from.
  sourceExerciseId String?

  source       String @default("rule") // "rule" | "ai" | "manual"
  setDelta     Int    @default(0)
  loadDeltaPct Float  @default(0)
  targetRir    Int

  reasonEn String
  reasonPt String
  payload  String? // JSON snapshot of the engine inputs

  createdAt DateTime @default(now())
}
